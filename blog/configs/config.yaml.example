# 应用配置
app:
  name: "blog-project"
  version: "1.0.0"
  mode: "release"  # debug, release, test
  host: "192.168.100.100"     # 地址：邮件中链接访问使用
  port: 9527                  # 端口

# 数据库配置
# 主库已从 MySQL 迁到 PostgreSQL（向量检索需要 pgvector 与业务表同库）
database:
  postgres:
    host: "192.168.100.100"     # docker 部署时改成 postgres（compose 里的服务名）
    port: 5432
    username: "postgres"        # 账号
    password: "xxxx"            # 密码，容器里可用 PG_PASSWORD 环境变量覆盖
    database: "blog-project"
    ssl_mode: "disable"         # 内网/本机一律 disable；公网暴露时才考虑 require
    time_zone: "Asia/Shanghai"  # 影响 timestamptz 的读写换算，别乱改
    max_idle_conns: 10
    max_open_conns: 50          # PG 每连接占内存，别照抄 MySQL 的 100
  redis:
    host: "192.168.100.100"     # 地址，如果docker部署要改成redis
    port: 6379
    password: "xxxx"            # 密码
    db: 0
    pool_size: 10

# JWT 配置
jwt:
  secret: "blog-project"
  access_expire_minutes: 15     # 访问token过期时间 单位：分钟
  refresh_expire_hours: 72      # 刷新token过期时间 单位：小时

# 日志配置
log:
  level: "info"  # debug, info, warn, error
  filename: "logs/app.log"
  max_size: 100    # MB
  max_backups: 3   # 保留旧文件的最大个数
  max_age: 25      # 保留旧文件的最大天数
  compress: true   # 是否压缩

# CORS 配置
cors:
  enabled: true
  allow_origins:
    - "*"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization"

#邮箱配置
email:
  host: "smtp.qq.com"
  port: 587
  username: "xxx@qq.com"        # QQ邮箱
  password: "xxx"               # SMTP授权码
  from: "xxx@qq.com"            # QQ邮箱

# MinIO 配置
minio:
  endpoint: "xxx:9000"                                # MinIO 服务地址
  access_key_id:                            # Access Key
  access_key_secret:                        # Secret Key
  bucket_name: "blog-project"               # Bucket 名称
  use_ssl: false                            # 是否使用 SSL
  base_url: "xxx:9000"                                # 文件访问 URL 基础地址（外部浏览器访问）

# 默认管理员配置
default_admin:
  enabled: true               # 是否自动创建管理员（开启后检测不存在时自动创建）
  username: "admin"
  account: "00000000000"      # 账号：11位数字
  password: "admin123456"
