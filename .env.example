# ============================================================
# 生产环境变量模板
# 复制为服务器上的 /opt/blog/.env，切勿提交真实值到仓库
# ============================================================

# ---------- 镜像仓库（阿里云容器镜像服务 ACR） ----------
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace

# 由 GitHub Actions 的 deploy.sh 自动写入，首次部署填 latest 即可
IMAGE_TAG=latest

# ---------- 数据库 ----------
MYSQL_PASSWORD=改成强密码
MYSQL_DATABASE=blog-project

# ---------- 对象存储 ----------
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=改成强密码

# ---------- LLM ----------
LLM_MODEL_NAME=gemma3:270m
